{
  "name": "@shipwright/db",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./types": "./src/types.ts",
    "./repositories/*": "./src/repositories/*.ts"
  },
  "dependencies": {
    "@shipwright/config": "workspace:*",
    "@shipwright/observability": "workspace:*",
    "@shipwright/shared": "workspace:*"
  },
  "peerDependencies": {
    "@effect/sql-pg": "4.0.0-rc.112",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@effect/sql-pg": "4.0.0-rc.112",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "pg": "^8.22.0"
  }
}
