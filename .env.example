# Root .env.example — docker-compose infra vars only.
# App vars live in apps/api/.env.example and apps/web/.env.example.

POSTGRES_DB=shipwright
POSTGRES_USER=shipwright
POSTGRES_PASSWORD=shipwright

RUSTFS_ACCESS_KEY=shipwright
RUSTFS_SECRET_KEY=shipwright_secret

# Langfuse infra
LANGFUSE_SALT=changeme_base64_32chars
LANGFUSE_NEXTAUTH_SECRET=changeme_base64_32chars
LANGFUSE_ENCRYPTION_KEY=changeme_hex_64chars
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse
LANGFUSE_REDIS_AUTH=langfuse
LANGFUSE_MINIO_PASSWORD=langfuse
LANGFUSE_INIT_USER_PASSWORD=shipwright

LANGFUSE_OTLP_ENDPOINT=http://localhost:3001/api/public/otel
LANGFUSE_PUBLIC_KEY=pk-lf-shipwright
LANGFUSE_SECRET_KEY=sk-lf-shipwright
