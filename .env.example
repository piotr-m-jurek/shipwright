# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Must point to a Postgres instance with pgvector enabled.
DATABASE_URL=postgres://user:password@localhost:5432/shipwright

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
# Base URL of the S3-compatible storage service (rustfs locally, Supabase Storage in prod).
S3_ENDPOINT=http://localhost:9000
# S3 bucket name.
S3_BUCKET=shipwright
# S3 credentials.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Comma-separated list of origins allowed to make pre-signed URL requests.
S3_ALLOWED_ORIGINS=http://localhost:3001

# ─── AI ──────────────────────────────────────────────────────────────────────
# Anthropic API key — used for all LLM calls via @effect/ai-anthropic.
ANTHROPIC_API_KEY=sk-ant-...
# URL of the Text Embeddings Inference (TEI) server for generating embeddings.
TEI_URL=http://localhost:8080

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# GitHub OAuth application credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of trusted origins for CORS and Better Auth.
ALLOWED_ORIGINS=http://localhost:3001

# ─── Observability (Langfuse) — optional ─────────────────────────────────────
# If all three are set, OTLP traces are exported to Langfuse.
# Leave blank to disable observability.
LANGFUSE_OTLP_ENDPOINT=http://localhost:3030/api/public/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
