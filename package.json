{
  "name": "shipwright",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "@effect/tsgo"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "bun run --filter '*' build",
    "dev": "bun run --filter '@shipwright/*' --parallel dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:mcp": "bun run --cwd apps/mcp dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' --parallel lint",
    "fmt": "bun run --filter '*' --parallel fmt",
    "db:reset": "scripts/db-reset.sh",
    "session:requeue": "scripts/session-requeue.sh",
    "docs:effect-update": "git subtree pull --prefix docs/effect-smol effect-smol main --squash",
    "docs:effect-atom-update": "git subtree pull --prefix docs/effect-atom effect-atom main --squash"
  },
  "dependencies": {
    "effect": "4.0.0-beta.103",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.24.2"
  }
}
