{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    // TODO: restore verbatimModuleSyntax: true once TypeScript-Go fixes
    // package.json discovery in LSP mode. Right now tsgo running from the
    // monorepo root misclassifies every .ts file as CommonJS (ignoring
    // apps/api/package.json "type":"module"), which causes verbatimModuleSyntax
    // to fire on every import/export. moduleDetection:"force" does not help
    // because tsgo 7.x does not implement it yet.
    // "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
