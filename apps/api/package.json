{
  "name": "@shipwright/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/server/server.ts",
    "start": "node --env-file=.env --import tsx/esm src/server/server.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:phase4": "node --env-file=.env --import tsx/esm src/agent/tests/test-phase4-gate.ts",
    "test:phase5": "node --env-file=.env --import tsx/esm src/agent/tests/test-phase5-gate.ts",
    "test:phase5b": "node --env-file=.env --import tsx/esm src/agent/tests/test-phase5b-gate.ts",
    "test:corpus": "node --env-file=.env --import tsx/esm src/agent/tests/test-corpus.ts",
    "test:evals": "node --env-file=.env --import tsx/esm src/agent/tests/evals.ts",
    "test:transactions": "vitest run src/agent/tests/transactions.test.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint .",
    "fmt": "oxfmt src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1055.0",
    "@aws-sdk/s3-request-presigner": "3.1057.0",
    "@better-auth/drizzle-adapter": "1.7.0-rc.1",
    "@effect/ai-anthropic": "4.0.0-beta.103",
    "@effect/ai-openai": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "@shipwright/shared": "workspace:*",
    "better-auth": "1.7.0-rc.1",
    "drizzle-orm": "1.0.0-rc.4",
    "file-type": "22.0.1",
    "js-tiktoken": "1.0.21",
    "mammoth": "1.12.0",
    "pg": "^8.22.0",
    "unpdf": "1.6.2",
    "xstate": "5.32.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsx": "4.22.3",
    "vitest": "4.1.8"
  }
}
