{
  "name": "@shipwright/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=.env src/server/server.ts",
    "start": "bun --env-file=.env src/server/server.ts",
    "build": "bun build --target=bun src/server/server.ts --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:phase4": "bun --env-file=.env src/agent/tests/test-phase4-gate.ts",
    "test:phase5": "bun --env-file=.env src/agent/tests/test-phase5-gate.ts",
    "test:phase5b": "bun --env-file=.env src/agent/tests/test-phase5b-gate.ts",
    "test:corpus": "bun --env-file=.env src/agent/tests/test-corpus.ts",
    "test:evals": "bun --env-file=.env src/agent/tests/evals.ts",
    "test:transactions": "vitest run src/agent/tests/transactions.test.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt src"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.0-beta.103",
    "@effect/ai-openai": "4.0.0-beta.103",
    "@effect/platform-bun": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "@shipwright/auth": "workspace:*",
    "@shipwright/config": "workspace:*",
    "@shipwright/db": "workspace:*",
    "@shipwright/queue": "workspace:*",
    "@shipwright/shared": "workspace:*",
    "@shipwright/storage": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "file-type": "22.0.1",
    "js-tiktoken": "1.0.21",
    "mammoth": "1.12.0",
    "pg": "^8.22.0",
    "unpdf": "1.6.2",
    "xstate": "5.32.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1055.0",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.14",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "vitest": "4.1.8"
  }
}
