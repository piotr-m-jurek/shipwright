{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "react/self-closing-comp": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  }
}
